{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stak-moderation-center",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".vinext/assets", "binding": "ASSETS", "not_found_handling": "none" },
  "kv_namespaces": [{ "binding": "VINEXT_KV_CACHE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "d1_databases": [{ "binding": "DB", "database_name": "stak-moderation-db", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }]
}
